# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/task_management?replicaSet=rs0

# Comma-separated list of website origins allowed to call the API with cookies.
ALLOWED_ORIGINS=http://localhost:5173
# Base URL of the website, used to build setup/reset links.
WEB_BASE_URL=http://localhost:5173

BUSINESS_TIMEZONE=Asia/Karachi
DEFAULT_PHONE_COUNTRY=PK

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Set to true behind HTTPS (always true in production).
COOKIE_SECURE=false
TRUST_PROXY=false

SETUP_TOKEN_HOURS=72
RESET_TOKEN_MINUTES=60

# Google Drive backups (server-side OAuth, drive.file scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/admin/integrations/drive/callback
# 32-byte base64 key used to encrypt the stored Drive refresh token.
DRIVE_TOKEN_ENCRYPTION_KEY=

# Backup encryption keys: JSON map of keyId -> base64 32-byte key. Keep a separate recovery copy OUTSIDE Drive.
BACKUP_ENCRYPTION_KEYS={"k1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
BACKUP_ACTIVE_KEY_ID=k1
BACKUP_TMP_DIR=./tmp/backups
# Optional: path to mongodump. When empty, a consistent snapshot-session export is used.
MONGODUMP_PATH=

LOG_LEVEL=info
